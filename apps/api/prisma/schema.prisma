generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
}

enum AccessStatus {
  ACTIVE
  BLOCKED
}

enum UserRole {
  ADMIN
  MEMBER
}

model Organization {
  id                   String         @id @default(cuid())
  name                 String
  legalName            String?
  brandAddress         String?
  phone                String?
  email                String?
  logoKey              String?
  logoMime             String?
  licenseStatus        LicenseStatus  @default(ACTIVE)
  inn                  String?
  kpp                  String?
  ogrn                 String?
  legalAddress         String?
  bankName             String?
  bik                  String?
  checkingAccount      String?
  correspondentAccount String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  users                User[]
  tasks                Task[]
  counterparties       Counterparty[]
  products             Product[]
  productAttributeTemplates ProductAttributeTemplate[]
  productGroups        ProductGroup[]
  warehouseCategories  WarehouseCategory[]
  warehouses           Warehouse[]
  deals                Deal[]
  dealStatusConfigs    DealStatusConfig[]
  purchases            Purchase[]
  productionTypes      ProductionType[]
  productionJobs       ProductionJob[]
  mailMessages         MailMessage[]
  roles                Role[]
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  role           UserRole       @default(MEMBER)
  status         AccessStatus   @default(ACTIVE)
  mailSignature  String?
  avatarKey      String?
  avatarMime     String?
  jobTitle       String?
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  roleId         String
  accessRole     Role           @relation(fields: [roleId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  otpChallenges  OtpChallenge[]
  sessions       Session[]
  ownedTasks     Task[]         @relation("TaskOwner")
  createdTasks   Task[]         @relation("TaskCreator")
  assignedTasks  TaskAssignee[]
  taskComments   TaskComment[]  @relation("TaskCommentAuthor")
  createdDeals   Deal[]         @relation("DealCreator")
  dealMessages   DealMessage[]
  stockMovements StockMovement[]
  purchases      Purchase[]     @relation("PurchaseCreator")
  productionJobs ProductionJob[] @relation("ProductionJobCreator")
  mailMessages   MailMessage[]

  @@index([roleId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  pages          String[]
  locked         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum TaskBoard {
  PERSONAL
  ORGANIZATION
}

enum TaskStatus {
  NEW
  APPROVAL
  IN_PROGRESS
  REVIEW
  DONE
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  board          TaskBoard
  status         TaskStatus   @default(NEW)
  title          String
  description    String?
  position       Float        @default(0)
  ownerId        String?
  owner          User?        @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User         @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignees      TaskAssignee[]
  comments       TaskComment[]
  files          TaskFile[]

  @@index([organizationId, board, ownerId, status])
  @@index([organizationId, board, status, position])
}

model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskComment {
  id        String     @id @default(cuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  body      String     @default("")
  createdAt DateTime   @default(now())
  files     TaskFile[]

  @@index([taskId, createdAt])
}

model TaskFile {
  id         String       @id @default(cuid())
  taskId     String
  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    TaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  name       String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime     @default(now())

  @@index([taskId])
  @@index([commentId])
  @@index([storageKey])
}

model Counterparty {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  legalName            String
  inn                  String
  kpp                  String?
  ogrn                 String?
  legalAddress         String
  actualAddress        String?
  bankName             String?
  bik                  String?
  checkingAccount      String?
  correspondentAccount String?
  email                String
  phone                String?
  telegram             String?
  contactName          String?
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, inn])
  @@index([organizationId, name])
  deals     Deal[]
  purchases Purchase[]
}

enum DealStatus {
  NEW
  IN_PROGRESS
  INVOICE_ISSUED
  PAID
  TO_PRODUCTION
  SHIPPED_TO_WAREHOUSE
  TO_DELIVERY
  DELIVERED
  RETURNED
  CLOSED
}

enum DealChannel {
  EMAIL
  TELEGRAM
  PHONE
}

enum DealMessageDirection {
  IN
  OUT
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])
  title          String
  description    String?
  dueDate        DateTime?
  status         DealStatus   @default(NEW)
  position       Float        @default(0)
  createdById    String
  createdBy      User         @relation("DealCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          DealItem[]
  messages       DealMessage[]
  documents      DealDocument[]
  events         DealEvent[]
  productionJobs ProductionJob[]

  @@index([organizationId, status, position])
}

model DealStatusConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         DealStatus
  label          String
  color          String
  position       Int

  @@unique([organizationId, status])
  @@index([organizationId, position])
}

enum ProductKind {
  CONSUMABLE
  MATERIAL
  SEMI_FINISHED
  FINISHED
}

enum StockMovementType {
  RECEIPT
  WRITEOFF
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           ProductKind  @default(FINISHED)
  categoryId     String
  category       WarehouseCategory @relation(fields: [categoryId], references: [id])
  groupId        String?
  group          ProductGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  inCatalog      Boolean      @default(false)
  name           String
  sku            String?
  unit           String       @default("шт")
  price          Float
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  images         ProductImage[]
  attributes     ProductAttribute[]
  dealItems      DealItem[]
  movements      StockMovement[]
  lots           StockLot[]
  purchaseItems  PurchaseItem[]
  stageOutputs   ProductionStageOutput[] @relation("StageOutput")
  stageInputs    ProductionStageInput[] @relation("StageInput")
  productionTypes ProductionType[] @relation("ProductionTypeProduct")

  @@unique([organizationId, sku])
  @@index([organizationId, kind, name])
  @@index([organizationId, categoryId])
  @@index([organizationId, groupId])
  @@index([organizationId, inCatalog])
}

model WarehouseCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId, position])
}

model ProductGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]
  stageInputs    ProductionStageInput[]

  @@unique([organizationId, name])
  @@index([organizationId, name])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey String
  mimeType   String
  size       Int
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId, position])
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String
  position  Int     @default(0)

  @@index([productId, position])
}

model ProductAttributeTemplate {
  id             String                         @id @default(cuid())
  organizationId String
  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime                       @default(now())
  items          ProductAttributeTemplateItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ProductAttributeTemplateItem {
  id         String                   @id @default(cuid())
  templateId String
  template   ProductAttributeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  value      String
  position   Int                      @default(0)

  @@index([templateId, position])
}

model Warehouse {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  movements      StockMovement[]
  lots           StockLot[]
  purchases      Purchase[]
  productionTypes ProductionType[]
  productionJobs  ProductionJob[]

  @@index([organizationId, name])
}

model StockLot {
  id               String   @id @default(cuid())
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Float
  receivedAt       DateTime  @default(now())
  sourceMovementId String?
  sourceMovement   StockMovement? @relation("LotSource", fields: [sourceMovementId], references: [id], onDelete: SetNull)
  allocations      StockMovementAllocation[]

  @@index([warehouseId, productId, receivedAt])
  @@index([sourceMovementId])
}

model StockMovement {
  id          String             @id @default(cuid())
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        StockMovementType
  quantity    Float
  note        String?
  purchaseId  String?
  purchase    Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  productionJobId String?
  productionJob   ProductionJob? @relation(fields: [productionJobId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  lotsCreated StockLot[]         @relation("LotSource")
  allocations StockMovementAllocation[]

  @@index([warehouseId, productId, createdAt])
  @@index([purchaseId])
  @@index([productionJobId])
}

model StockMovementAllocation {
  id         String        @id @default(cuid())
  movementId String
  movement   StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  lotId      String
  lot        StockLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  quantity   Float

  @@index([movementId])
  @@index([lotId])
}

enum PurchaseStatus {
  DRAFT
  POSTED
}

model Purchase {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  title          String
  counterpartyId String
  counterparty   Counterparty   @relation(fields: [counterpartyId], references: [id])
  warehouseId    String
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  status         PurchaseStatus @default(DRAFT)
  purchasedAt    DateTime
  note           String?
  createdById    String
  createdBy      User           @relation("PurchaseCreator", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          PurchaseItem[]
  documents      PurchaseDocument[]
  movements      StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, purchasedAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  name       String
  quantity   Float
  unit       String   @default("шт")
  price      Float

  @@index([purchaseId])
}

model PurchaseDocument {
  id         String    @id @default(cuid())
  purchaseId String
  purchase   Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  title      String
  number     String?
  issuedAt   DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([purchaseId])
}

enum ProductionJobStatus {
  ACTIVE
  DONE
}

enum ProductionStageStatus {
  TO_START
  IN_PROGRESS
}

enum DealItemProductionStatus {
  NONE
  IN_PRODUCTION
  IN_WAREHOUSE
}

model ProductionType {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  productId      String
  product        Product            @relation("ProductionTypeProduct", fields: [productId], references: [id])
  warehouseId    String
  warehouse      Warehouse          @relation(fields: [warehouseId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  stages         ProductionStage[]
  jobs           ProductionJob[]

  @@unique([organizationId, productId])
  @@index([organizationId, name])
}

model ProductionStage {
  id          String                  @id @default(cuid())
  typeId      String
  type        ProductionType          @relation(fields: [typeId], references: [id], onDelete: Cascade)
  name        String
  position    Int
  lossPercent Float                   @default(0)
  jobs        ProductionJob[]
  inputs      ProductionStageInput[]
  outputs     ProductionStageOutput[]

  @@index([typeId, position])
}

model ProductionStageInput {
  id             String          @id @default(cuid())
  stageId        String
  stage          ProductionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?        @relation("StageInput", fields: [productId], references: [id], onDelete: Restrict)
  productGroupId String?
  productGroup   ProductGroup?   @relation(fields: [productGroupId], references: [id], onDelete: Restrict)
  quantity       Float

  @@index([stageId])
  @@index([productId])
  @@index([productGroupId])
}

model ProductionStageOutput {
  id        String          @id @default(cuid())
  stageId   String
  stage     ProductionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation("StageOutput", fields: [productId], references: [id], onDelete: Restrict)
  quantity  Float

  @@unique([stageId, productId])
}

model ProductionJob {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  typeId         String
  type           ProductionType       @relation(fields: [typeId], references: [id])
  stageId        String
  stage          ProductionStage      @relation(fields: [stageId], references: [id])
  warehouseId    String
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id])
  dealId         String?
  deal           Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealItemId     String?              @unique
  dealItem       DealItem?            @relation(fields: [dealItemId], references: [id], onDelete: SetNull)
  title          String
  quantity       Float
  status         ProductionJobStatus  @default(ACTIVE)
  stageStatus    ProductionStageStatus @default(TO_START)
  position       Float                @default(0)
  createdById    String
  createdBy      User                 @relation("ProductionJobCreator", fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  movements      StockMovement[]

  @@index([organizationId, typeId, status])
  @@index([dealId])
}

model DealItem {
  id                 String                    @id @default(cuid())
  dealId             String
  deal               Deal                      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  name               String
  quantity           Float
  unit               String                    @default("шт")
  price              Float
  productionStatus   DealItemProductionStatus  @default(NONE)
  productionJobs     ProductionJob[]
}

model DealMessage {
  id        String               @id @default(cuid())
  dealId    String
  deal      Deal                 @relation(fields: [dealId], references: [id], onDelete: Cascade)
  channel   DealChannel
  direction DealMessageDirection
  body      String
  authorId  String?
  author    User?                @relation(fields: [authorId], references: [id])
  createdAt DateTime             @default(now())

  @@index([dealId, channel, createdAt])
}

model DealDocument {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title     String
  kind      String   @default("INVOICE")
  html      String
  sentAt    DateTime?
  createdAt DateTime @default(now())
}

model DealEvent {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
}

enum MailFolder {
  INBOX
  SENT
  DRAFTS
  SPAM
  ARCHIVE
}

model MailMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder         MailFolder
  fromAddress    String
  fromName       String
  toAddress      String
  toName         String
  subject        String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  attachments    MailAttachment[]

  @@index([userId, folder, createdAt])
}

model MailAttachment {
  id         String       @id @default(cuid())
  messageId  String
  message    MailMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name       String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime     @default(now())

  @@index([messageId])
  @@index([storageKey])
}
