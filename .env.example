# API
DATABASE_URL=postgresql://faverum:faverum@localhost:5432/faverum
REDIS_URL=redis://localhost:6379
PORT=3000
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
OTP_PEPPER=change-me-in-production
OTP_DEV_CODE=111111
# Разрешает код 111111 для *@faverum.local даже в production.
OTP_ALLOW_DEV_CODE=false
SESSION_DAYS=14

# Control plane (отдельный сервис: /Users/yoshiwithyou/Projects/faverum_web_control)
# Пока не используется: лицензия проверяется локально. Потом — только Control.
# CONTROL_API_URL=
# CONTROL_INSTANCE_KEY=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Faverum <noreply@faverum.local>
# Novofon (звонки и SMS во вкладке «Телефон» у сделки)
# Без ключей действия пишутся в ленту локально.
NOVOFON_API_URL=https://api.novofon.com
NOVOFON_USER_KEY=
NOVOFON_SECRET=
NOVOFON_FROM=
NOVOFON_SMS_CALLER_ID=
